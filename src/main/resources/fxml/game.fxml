<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="680.0" prefWidth="880.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sojourners.chess.controller.GameController">
    <top>
        <HBox alignment="CENTER_LEFT" minHeight="-Infinity" prefHeight="40.0" spacing="6.0" styleClass="tool-bar">
            <children>
                <Label text="棋力" />
                <ComboBox fx:id="skillComboBox" maxWidth="96.0" minWidth="96.0" prefWidth="96.0" />
                <Label text="执棋" />
                <Button fx:id="sideButton" maxWidth="96.0" minWidth="96.0" mnemonicParsing="false" onAction="#sideButtonClick" prefWidth="96.0" text="引擎执黑" />
                <Label text="局时" />
                <ComboBox fx:id="clockComboBox" maxWidth="96.0" minWidth="96.0" prefWidth="96.0" />
                <Button fx:id="startButton" mnemonicParsing="false" onAction="#startButtonClick" prefHeight="26.0" prefWidth="84.0" styleClass="primary-button" text="开始对弈">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="resignButton" managed="false" mnemonicParsing="false" onAction="#resignButtonClick" prefHeight="26.0" prefWidth="72.0" text="认输" visible="false">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="suspendButton" managed="false" mnemonicParsing="false" onAction="#suspendButtonClick" prefHeight="26.0" prefWidth="72.0" text="封棋" visible="false">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="reviewButton" managed="false" mnemonicParsing="false" onAction="#reviewButtonClick" prefHeight="26.0" prefWidth="72.0" text="复盘" visible="false">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Button>
                <Region maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="settingButton" mnemonicParsing="false" onAction="#settingButtonClick" text="设置" />
                <Button fx:id="backMenuButton" mnemonicParsing="false" onAction="#backToMenuClick" text="返回主菜单">
                    <HBox.margin>
                        <Insets right="10.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="canvasPane" minHeight="0.0" minWidth="0.0" BorderPane.alignment="CENTER">
            <children>
                <Canvas fx:id="canvas" height="620.0" onMouseClicked="#canvasClick" width="560.0" />
            </children>
        </StackPane>
    </center>
    <left>
        <VBox fx:id="leftPanel" alignment="TOP_CENTER" spacing="6.0" style="-fx-padding: 10px 14px 10px 14px;" BorderPane.alignment="CENTER">
            <children>
                <VBox fx:id="clockBox" alignment="TOP_CENTER" maxHeight="Infinity" maxWidth="Infinity" spacing="8.0" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox fx:id="blackClockPanel" alignment="CENTER" maxWidth="Infinity" spacing="24.0" styleClass="clock-panel">
                            <children>
                                <Label text="黑" style="-fx-background-color: #2f3b46;" styleClass="clock-side" />
                                <VBox alignment="CENTER" spacing="0.0">
                                    <children>
                                        <Label text="局时" styleClass="clock-caption" />
                                        <Label fx:id="blackClockMain" styleClass="clock-time" text="05:00" />
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" spacing="0.0">
                                    <children>
                                        <Label text="步时" styleClass="clock-caption" />
                                        <Label fx:id="blackClockMove" styleClass="clock-time" text="01:00" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <StackPane fx:id="clockSpacer" maxHeight="Infinity" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                            <children>
                                <Label fx:id="lowSecondsLabel" styleClass="low-seconds" text="" />
                            </children>
                        </StackPane>
                        <HBox fx:id="redClockPanel" alignment="CENTER" maxWidth="Infinity" spacing="24.0" styleClass="clock-panel">
                            <children>
                                <Label text="红" style="-fx-background-color: #c0392b;" styleClass="clock-side" />
                                <VBox alignment="CENTER" spacing="0.0">
                                    <children>
                                        <Label text="局时" styleClass="clock-caption" />
                                        <Label fx:id="redClockMain" styleClass="clock-time" text="05:00" />
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" spacing="0.0">
                                    <children>
                                        <Label text="步时" styleClass="clock-caption" />
                                        <Label fx:id="redClockMove" styleClass="clock-time" text="01:00" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>
    <right>
        <StackPane fx:id="rightPanel" alignment="BOTTOM_RIGHT" style="-fx-padding: 10px 14px 10px 14px;" BorderPane.alignment="CENTER">
            <children>
                <StackPane fx:id="statusOverlay" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="status-overlay" StackPane.alignment="BOTTOM_RIGHT">
                    <children>
                        <Label fx:id="statusLabel" alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity" styleClass="status-text" text="请设置对弈配置后开始" textAlignment="CENTER" wrapText="true" />
                    </children>
                </StackPane>
            </children>
        </StackPane>
    </right>
</BorderPane>
