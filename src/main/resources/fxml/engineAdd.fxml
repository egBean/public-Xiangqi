<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="420.0" prefWidth="500.0" spacing="12.0" style="-fx-padding: 18px 24px 16px 24px;" stylesheets="@../style/gameSetting.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sojourners.chess.controller.EngineAddController">
   <children>
      <GridPane hgap="12.0" vgap="10.0">
         <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="56.0" prefWidth="56.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="300.0" />
         </columnConstraints>
         <children>
            <Label text="路径" />
            <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1">
               <children>
                  <TextField fx:id="pathText" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#selectButtonClick" text="选择" />
               </children>
            </HBox>
            <Label text="名称" GridPane.rowIndex="1" />
            <TextField fx:id="nameText" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="协议" GridPane.rowIndex="2" />
            <TextField fx:id="protocolText" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>

      <Label text="引擎选项" styleClass="section-title" />

      <ListView fx:id="optionsListView" focusTraversable="false" VBox.vgrow="ALWAYS" />

      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#okButtonClick" prefHeight="30.0" prefWidth="84.0" text="确定" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#cancelButtonClick" prefHeight="30.0" prefWidth="84.0" text="取消" />
         </children>
      </HBox>
   </children>
</VBox>
